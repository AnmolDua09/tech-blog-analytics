# 🖥️ Server Config
PORT=3000
NODE_ENV=development

# 🍃 MongoDB Connection (Content Layer)
# If using Docker, this might be 'mongodb://mongodb:27017/tech_blog'
MONGODB_URI=mongodb://localhost:27017/tech_blog

# 🐘 PostgreSQL Connection (Analytics Layer)
# Using a single URL is cleaner for Sequelize
POSTGRES_URL=postgres://admin:password@localhost:5432/analytics_db

# 🔐 Security
# Change this to something unique for your project
JWT_SECRET=Anmol_Dua_Zomato_Intern_2026_Secure_Key

# 🌐 Frontend Bridge
FRONTEND_URL=http://localhost:4200